<%- include('layouts/header'); -%>
<%if(paymentError){%><p class="payment-error" role="alert"><%=paymentError%></p><%}%><section class="cart-shell">
  <% const count=products.reduce((sum,item)=>sum+item.quantity,0); %>
  <a class="cart-back" href="/#catalogue">← Continue shopping</a>
  <header class="cart-heading"><div><span class="eyebrow">A LITTLE UPGRADE FOR YOUR EVERYDAY</span><h1>Your bag<span><%=count%></span></h1></div><p><%=count ? 'A few good choices. Ready when you are.' : 'Good things are waiting to be discovered.'%></p></header>
  <p class="cart-feedback" role="status" aria-live="polite"></p>
  <%if(!products.length){%>
  <div class="cart-empty"><div class="cart-empty-icon" aria-hidden="true"><svg viewBox="0 0 64 64" width="56" height="56" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22h34l4 32H11l4-32Z"/><path d="M23 24V17a9 9 0 0 1 18 0v7"/></svg></div><span class="eyebrow">ROOM FOR SOMETHING GOOD</span><h2>Your next favourite is out there.</h2><p>Explore our collection of everyday tech.<br>When something catches your eye, add it here.</p><a class="primary-link" href="/#catalogue">Explore the collection <span>↗</span></a><div class="cart-empty-categories"><a href="/?catagory=headphone#catalogue">Headphones</a><span>·</span><a href="/?catagory=phone#catalogue">Phones</a><span>·</span><a href="/?catagory=gaming#catalogue">Gaming</a></div></div>
  <%}else{%>
  <div class="cart-columns"><div class="cart-list"><div class="cart-list-heading"><span>YOUR ITEMS</span><span><%=products.length%> <%=products.length===1?'product':'products'%></span></div>
  <%products.forEach(item=>{const p=item.productId;%>
  <article class="cart-row" data-cart-item="<%=item._id%>"><a class="cart-product-image" href="/pDetail?pid=<%=p._id%>"><%if(p.image && p.image[0]){%><img src="data:<%=p.image[0].contentType%>;base64,<%=p.image[0].data%>" alt="<%=p.name%>"><%}else{%><span>Image coming soon</span><%}%></a>
  <div class="cart-product-details"><span class="eyebrow"><%=p.brand%></span><h2><a href="/pDetail?pid=<%=p._id%>"><%=p.name%></a></h2><p><%-money(p.price)%> <span>/ each</span></p>
  <form class="cart-quantity" action="/updateCart" method="POST" data-cart-change><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="pId" value="<%=item._id%>"><label class="sr-only" for="qty-<%=item._id%>">Quantity for <%=p.name%></label><div class="cart-stepper"><button type="button" data-step="-1" aria-label="Decrease <%=p.name%> quantity" ><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14"/></svg></button><input id="qty-<%=item._id%>" type="number" name="quantity" min="1" max="99" step="1" value="<%=item.quantity%>" required><button type="button" data-step="1" aria-label="Increase <%=p.name%> quantity" <%=item.quantity>=99?'disabled':''%>><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg></button></div><button type="submit" class="cart-update">Update</button></form></div>
  <div class="cart-row-end"><strong><%-money(p.price*item.quantity)%></strong><form action="/deleteCart" method="POST" data-cart-change><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="pId" value="<%=item._id%>"><button class="cart-remove" type="submit" aria-label="Remove <%=p.name%> from bag">Remove</button></form></div></article><%})%>
  <p class="cart-list-note">Need more than one? Adjust the quantity above.</p></div>
  <aside class="cart-checkout"><span class="eyebrow">THE DETAILS</span><h2>Order summary</h2><%if(currentProfile && profileComplete){const a=currentProfile.address;%><div class="checkout-delivery"><strong>Deliver to <%=currentProfile.name%></strong><p><%=a.line1%><%=a.line2?', '+a.line2:''%>, <%=a.city%>, <%=a.region || ''%> <%=a.postalCode%>, <%=a.country%><br><%=currentProfile.phone%></p><a href="/profile">Edit details</a></div><%}else{%><p class="checkout-delivery">Contact and delivery details are required. <a href="/profile">Complete profile ↗</a></p><%}%><dl><div><dt>Subtotal <span>(<%=count%> items)</span></dt><dd><%-money(totalSub)%></dd></div><div><dt>Shipping</dt><dd><%-money(shipping)%></dd></div><div><dt>Tax</dt><dd><%-money(tax)%></dd></div><div class="cart-total"><dt>Total <small data-currency-code>MYR</small></dt><dd><%-money(totalPrice)%></dd></div></dl><form action="/postOrder" method="POST" class="cart-checkout-form"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><%-include('layouts/payment-options')%><button class="primary-link" type="submit">Pay & place order <span>↗</span></button></form><p class="cart-checkout-note">Simulated payment only — no money is charged.<br>Orders are recorded in MYR. Converted totals are estimates.</p><a class="cart-orders-link" href="/order">View previous orders</a></aside></div><%}%>
</section><script src="/javascripts/cart.js" defer></script><script src="/javascripts/payment.js" defer></script><%- include('layouts/footer'); -%>