<%-include('layouts/header')%><section class="purchase-page customer-orders"><%-include('layouts/order-navigation',{adminView:true})%><div class="section-heading"><div><span class="eyebrow">ADMIN · STORE MANAGEMENT</span><h1>Customer orders</h1><p><%=total%> <%=total===1?'order':'orders'%> received · Most recent first</p></div><a class="text-link" href="/admin/reports">Sales reports ↗</a></div><p class="field-hint">All orders across the store, including purchases made by your own account. These are demo orders; no payment has been collected.</p><%if(!orders.length){%><div class="catalogue-empty"><h2>No orders yet</h2><p>Orders placed through the bag or Buy now will appear here.</p></div><%}else{orders.forEach(order=>{%><details class="customer-order"><summary><div><span class="eyebrow">ORDER <%=order.id.slice(-8).toUpperCase()%></span><span class="order-placed-label">Placed by</span><h2><%=order.user.name || 'Customer'%> <%if(order.user.userId.toString()===user.id){%><span class="order-self-badge">Your account</span><%}%></h2><p class="order-customer-email"><%=order.delivery?.email || customerEmails[order.user.userId.toString()] || 'Email unavailable (older or deleted account)'%></p><p><%=new Date(order.orderDate).toLocaleString('en-SG',{timeZone:'Asia/Singapore',dateStyle:'medium',timeStyle:'short'})%> SGT</p><p><%=order.products.map(item=>item.productData.name+' × '+item.quantity).join(' · ')%></p></div><div class="customer-order-total"><strong><%-money(order.total)%></strong><span class="purchase-status"><%=order.payment?.status==='succeeded'?'Paid · simulation':'Legacy demo'%></span><span class="order-expand">View details ↓</span></div></summary><div class="customer-order-body"><%if(order.delivery?.email){%><p class="field-hint">Contact: <%=order.delivery.email%></p><%}%><%if(!order.delivery){%><p class="field-hint">Delivery details were not collected for this older order.</p><%}%><%-include('layouts/order-summary',{order})%></div></details><%});}%><%if(pages>1){%><nav class="store-pagination" aria-label="Order pages"><%if(page>1){%><a href="/admin/orders?page=<%=page-1%>">← Previous</a><%}%><span>Page <%=page%> of <%=pages%></span><%if(page<pages){%><a href="/admin/orders?page=<%=page+1%>">Next →</a><%}%></nav><%}%></section><%-include('layouts/footer')%>