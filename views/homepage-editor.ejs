<%-include('layouts/header')%><section class="profile-page"><a href="/" class="text-link">← Preview homepage</a><div class="profile-heading"><span class="eyebrow">STORE MANAGEMENT</span><h1>Homepage hero</h1><p>Edit the hero text, colours, button and featured collections.</p></div><%if(saved){%><p class="profile-success" role="status">Hero saved. <a href="/">View homepage ↗</a></p><%}%><form class="profile-form" id="hero-editor" method="POST"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="slides" id="hero-slides-data"><h2>Hero content</h2><div class="profile-fields"><label class="">Small heading<input name="eyebrow" type="text" maxlength="200" value="<%=config.content.eyebrow%>" ></label><label class="profile-wide">Main headline<textarea name="headline" rows="3" maxlength="200" required><%=config.content.headline%></textarea></label><label class="profile-wide">Description<textarea name="description" rows="3" maxlength="600" ><%=config.content.description%></textarea></label><label class="">Button text<input name="buttonText" type="text" maxlength="200" value="<%=config.content.buttonText%>" required></label><label class="">Button destination<input name="buttonHref" type="text" maxlength="200" value="<%=config.content.buttonHref%>" required></label><label class="">Footer label<input name="noteLabel" type="text" maxlength="200" value="<%=config.content.noteLabel%>" ></label><label class="profile-wide">Footer note<input name="note" type="text" maxlength="200" value="<%=config.content.note%>" ></label><label class="">Background colour<input name="background" type="color" maxlength="200" value="<%=config.content.background%>" ></label><label class="">Text colour<input name="textColor" type="color" maxlength="200" value="<%=config.content.textColor%>" ></label><label class="">Button colour<input name="buttonColor" type="color" maxlength="200" value="<%=config.content.buttonColor%>" ></label></div><p class="field-hint">Line breaks are preserved. Button destination must be a local path such as /?collection=travel#catalogue or #catalogue.</p><h2>Collection carousel</h2><label class="hero-check"><input type="checkbox" name="automatic" <%=config.automatic?'checked':''%>> Automatically feature collections</label><p class="field-hint">Uses up to 12 collection tags. If none exist, product categories are shown. Switch off to choose and order your slides.</p><label class="hero-check"><input type="checkbox" name="autoplay" <%=config.autoplay?'checked':''%>> Rotate slides automatically</label><label for="hero-interval">Seconds per slide (3–15)</label><input id="hero-interval" name="interval" type="number" min="3" max="15" value="<%=config.interval%>" required><h2>Custom slides</h2><p class="field-hint">Choose a collection, add a short caption and select a cover image. Use the arrows to reorder.</p><div id="hero-rows"></div><button type="button" id="hero-add" class="gallery-preview-button">+ Add slide</button><p id="hero-feedback" role="status"></p><div class="profile-actions"><a href="/">Cancel</a><button class="primary-link" type="submit">Save hero ↗</button></div></form><div id="hero-editor-data" hidden data-settings="<%=JSON.stringify({targets,products:products.map(p=>({id:String(p._id),name:p.name,tags:p.tags||[],category:p.catagory})),slides:config.slides})%>"></div></section><script src="/javascripts/hero-editor.js" defer></script><%-include('layouts/footer')%>