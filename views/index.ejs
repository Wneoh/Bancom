<%- include('layouts/header'); -%>
<section class="store-hero" style="--hero-bg:<%=hero.config.content.background%>;--hero-text:<%=hero.config.content.textColor%>;--hero-button:<%=hero.config.content.buttonColor%>"><div class="hero-copy"><span class="eyebrow"><%=hero.config.content.eyebrow%></span><h1><%=hero.config.content.headline%></h1><p><%=hero.config.content.description%></p><a class="primary-link" href="<%=hero.config.content.buttonHref%>"><%=hero.config.content.buttonText%> <span>↗</span></a><div class="hero-note"><span><%=hero.config.content.noteLabel%></span> <%=hero.config.content.note%></div></div><%-include('layouts/hero-carousel')%></section>
<section class="catalogue-section" id="catalogue" tabindex="-1"><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT UPGRADE</span><h2>Explore the collection</h2></div><span class="product-count"><%=totalProducts%> <%=totalProducts === 1 ? 'product' : 'products'%></span></div>
<% const categories = [['','All products'],['phone','Phones'],['computer','Computers'],['headphone','Headphones'],['camera','Cameras'],['gaming','Gaming'],['wearable','Wearables']]; const link = (c,p) => '/?' + new URLSearchParams({catagory:c,q:query,sort:sort,collection:collection,page:p}).toString(); %>
<nav class="category-tabs" aria-label="Product categories"><% categories.forEach(([value,label]) => { %><a class="<%= category === value ? 'selected' : '' %>" href="<%=link(value,1)%>" <%- category === value ? 'aria-current="page"' : '' %>><%=label%></a><% }) %></nav>
<%if(collections.length){%><nav class="collection-tabs" aria-label="Collections"><span class="eyebrow">COLLECTIONS</span><a class="<%=!collection?'selected':''%>" href="<%= '/?'+new URLSearchParams({catagory:category,q:query,sort,page:1}).toString()%>" <%-!collection?'aria-current="true"':''%>>All collections</a><%collections.forEach(tag=>{%><a class="<%=collection===tag._id?'selected':''%>" href="<%='/?'+new URLSearchParams({catagory:category,q:query,sort,collection:tag._id,page:1}).toString()%>" <%-collection===tag._id?'aria-current="true"':''%>><%=tag._id%> <small><%=tag.count%></small></a><%})%></nav><p class="collection-count-note">Collection counts include all categories.</p><%}else if(role==='admin'){%><p class="collection-count-note">Create collections by adding tags when you add or edit a product.</p><%}%><form class="catalogue-tools" action="/" method="GET"><input type="hidden" name="collection" value="<%=collection%>"><input type="hidden" name="catagory" value="<%=category%>"><div class="search-field"><label class="sr-only" for="search">Search products or brands</label><input id="search" type="search" name="q" value="<%=query%>" placeholder="Search products or brands"><button type="submit" aria-label="Search products">Search ↗</button></div><div class="sort-field"><label for="sort">Sort by</label><select id="sort" name="sort"><% [['newest','Newest arrivals'],['price-asc','Price: low to high'],['price-desc','Price: high to low'],['name','Name: A–Z']].forEach(([value,label])=>{ %><option value="<%=value%>" <%=sort===value ? 'selected' : ''%>><%=label%></option><% }) %></select><button type="submit">Apply</button></div></form>
<% if(products.some(p=>p.isDemo)){ %><p class="demo-notice"><span>DEMO COLLECTION</span> Fictional products with illustrative prices and specifications.</p><% } %><% if(products.length === 0) { %><div class="catalogue-empty"><span class="empty-symbol" aria-hidden="true">＋</span><h3><%=query || category || collection ? 'No matches just yet' : 'Something good starts here.'%></h3><p><%=query || category || collection ? 'Try another search or explore a different category.' : 'Our shelves are getting ready for their first arrivals. Check back soon.'%></p><% if(role === 'admin') { %><a class="primary-link" href="/addProduct">Add your first product ↗</a><% } else if(query || category || collection) { %><a class="text-link" href="/#catalogue">View all products ↗</a><% } %></div><% } else { %><div class="store-grid"><% products.forEach(product=>{ %><article class="store-card"><a href="/pDetail?pid=<%=product._id%>"><div class="card-image"><% if(product.image && product.image[0]) { %><img loading="lazy" src="data:<%=product.image[0].contentType%>;base64,<%=product.image[0].data%>" alt="<%=product.name%>"><% } else { %><span>Image coming soon</span><% } %><span class="card-arrow" aria-hidden="true">↗</span></div><span class="card-brand"><%=product.brand%></span><h3><%=product.name%></h3><p class="card-category"><%=categories.find(c=>c[0]===product.catagory)?.[1] || product.catagory%></p><p class="card-price"><%-money(product.price)%></p></a><%- include('layouts/bag-button', {item:product,detail:false}); -%><% if(role==='admin') { %><div class="card-admin"><a href="/editProduct?pid=<%=product._id%>">Edit product</a><form action="/deleteProduct" method="POST" data-confirm="Delete this product? This cannot be undone."><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="pid" value="<%=product._id%>"><button type="submit">Delete</button></form></div><% } %></article><% }) %></div><% } %>
<% if(lastPage>1) { %><nav class="store-pagination" aria-label="Pagination"><p class="pagination-range">Showing <%=(currentPage-1)*12+1%>–<%=Math.min(currentPage*12,totalProducts)%> of <%=totalProducts%> products</p><div class="pagination-controls"><% if(currentPage>1){ %><a href="<%=link(category,currentPage-1)%>" rel="prev" aria-label="Previous page">← Previous</a><% }else{ %><span class="pagination-disabled" aria-disabled="true">← Previous</span><% } %><%for(let p=1;p<=lastPage;p++){if(p===1 || p===lastPage || Math.abs(p-currentPage)<=1){%><a class="pagination-number" href="<%=link(category,p)%>" aria-label="Page <%=p%>" <%-p===currentPage?'aria-current="page"':''%>><%=p%></a><%}else if(p===currentPage-2 || p===currentPage+2){%><span aria-hidden="true">…</span><%}}%><% if(currentPage<lastPage){ %><a href="<%=link(category,currentPage+1)%>" rel="next" aria-label="Next page">Next →</a><% }else{%><span class="pagination-disabled" aria-disabled="true">Next →</span><%}%></div></nav><% } %></section>
<section class="store-values"><div><span>01 / DISCOVER</span><h3>Find your kind of tech.</h3><p>Explore six categories for work, play and everything between.</p></div><div><span>02 / COMPARE</span><h3>The details matter.</h3><p>Get to know product features and specifications before you choose.</p></div><div><span>03 / KEEP TRACK</span><h3>All in one place.</h3><p>Your account keeps your bag and order history close at hand.</p></div></section>
<%- include('layouts/footer'); -%>