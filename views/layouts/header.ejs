<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Bancom</title><link rel="icon" type="image/svg+xml" href="/images/icons/bancom.svg?v=1">
<link rel="preload" href="/fonts/plus-jakarta-sans/PlusJakartaSans-Variable.ttf" as="font" type="font/ttf" crossorigin>
<link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/media.css"><link rel="stylesheet" href="/stylesheets/refresh.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Trumbowyg/2.20.0/ui/trumbowyg.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Trumbowyg/2.20.0/trumbowyg.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Trumbowyg/2.20.0/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="/javascripts/confirm.js" defer></script><script src="/javascripts/editor.js" defer></script><script src="/javascripts/description_page.js" defer></script><script src="/javascripts/storefront.js" defer></script>
<script src="/javascripts/account-menu.js" defer></script><script src="/javascripts/bag.js" defer></script><script src="/javascripts/currency.js" defer></script></head><body><a class="skip-link" href="#main-content">Skip to content</a>
<div class="announcement">A little upgrade. A whole new everyday.</div>
<header class="site-header"><a class="wordmark" href="/" aria-label="Bancom home">Bancom<span>®</span></a>

<div class="header-actions"><% if (typeof loggedIn !== 'undefined' && loggedIn) { %><details class="account-menu"><summary><span class="header-avatar"><% if(currentProfile && currentProfile.avatar && currentProfile.avatar.data){ %><img src="data:<%=currentProfile.avatar.contentType%>;base64,<%=currentProfile.avatar.data%>" alt=""><% }else{ %><%= (currentProfile?.name || 'U').slice(0,1).toUpperCase() %><% } %></span><%= typeof user !== 'undefined' && user ? user.name : 'Account' %> <svg class="account-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></summary><div class="account-panel"><div class="account-panel-heading"><strong><%=currentProfile?.name || 'Your account'%></strong><span><%=role==='admin'?'Administrator':'Your Bancom account'%></span></div><nav aria-label="Personal account"><a href="/profile"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg><span>My profile<small>Photo & delivery details</small></span></a><a href="/order"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 7h14l1 14H4L5 7Z M9 7V5a3 3 0 0 1 6 0v2"/></svg><span><%=role==='admin'?'My purchases':'My orders'%><small>Your personal order history</small></span></a></nav><%if(role==='admin'){%><div class="account-section-label">STORE MANAGEMENT</div><nav aria-label="Store management"><a href="/admin/homepage"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M13 4v16M3 9h10"/></svg><span>Homepage hero<small>Featured collections & images</small></span></a><a href="/addProduct"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 8v8M8 12h8"/></svg><span>Add product<small>Create a catalogue item</small></span></a><a href="/admin/orders"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>Customer orders<small>Orders from all customers</small></span></a><a href="/admin/reports"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3v17h17M8 15v-4M13 15V7M18 15v-8"/></svg><span>Sales reports<small>Performance & insights</small></span></a></nav><%}%><form class="account-signout" action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><button type="submit"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 4H5v16h5M9 12h12m-4-4 4 4-4 4"/></svg><span>Sign out</span></button></form></div></details><% } else { %><a href="/login">Sign in</a><% } %><a class="cart-link" href="/cart"><svg class="header-bag-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 9V5a3 3 0 0 1 6 0v4"/></svg><span>Bag</span> <span class="bag-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span></a><details class="currency-menu"><summary aria-label="Choose display currency"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><span data-currency-code>MYR</span><svg class="currency-chevron" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></summary><div class="currency-panel"><span class="eyebrow">MAKE YOURSELF AT HOME</span><h2>Your currency</h2><div class="currency-choice"><label for="display-currency">Display currency</label><select id="display-currency"><option value="MYR">MYR · Malaysian ringgit</option><option value="SGD">SGD · Singapore dollar</option><option value="USD">USD · US dollar</option><option value="EUR">EUR · Euro</option><option value="GBP">GBP · British pound</option><option value="JPY">JPY · Japanese yen</option></select></div><details class="currency-info"><summary>About exchange rates</summary><p>Base prices and orders are in MYR. Conversions are estimates using daily reference rates from the European Central Bank via <a href="https://frankfurter.dev/" target="_blank" rel="noopener">Frankfurter ↗</a>. Rounded amounts may differ slightly.</p><p id="currency-status" role="status">MYR is the store's base currency.</p></details></div></details></div></header>
<noscript><p class="currency-noscript">Prices are in MYR. Enable JavaScript to change display currency.</p></noscript><main id="main-content"><% if(currentProfile && !profileComplete){ %><div class="profile-reminder"><span>Complete your contact and delivery details before checkout.</span><a href="/profile">Complete profile ↗</a></div><% } %>
