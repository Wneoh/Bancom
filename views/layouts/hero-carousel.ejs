<div class="hero-carousel" role="region" aria-roledescription="carousel" aria-label="Featured collections" data-autoplay="<%=hero.config.autoplay%>" data-interval="<%=hero.config.interval%>"><%if(hero.slides.length){hero.slides.forEach((slide,i)=>{%><article class="hero-slide" role="group" aria-roledescription="slide" aria-label="<%=i+1%> of <%=hero.slides.length%>" <%=i?'hidden':''%>><img class="hero-fit-<%=slide.fit%>" src="<%=slide.imageUrl || ("data:"+slide.image.contentType+";base64,"+slide.image.data)%>" alt="<%=slide.productName%>" <%=i?'loading=lazy':''%>><div class="hero-slide-caption"><span><%=slide.caption%></span><a href="<%=slide.href%>"><%=slide.linkText%> ↗</a></div></article><%});%><%if(hero.slides.length>1){%><div class="hero-carousel-controls" hidden><button type="button" data-hero-prev aria-label="Previous collection">←</button><span data-hero-position>1 / <%=hero.slides.length%></span><button type="button" data-hero-next aria-label="Next collection">→</button><button type="button" data-hero-pause aria-label="Pause automatic rotation">Pause</button></div><%}%><%}else{%><div class="hero-slide-empty"><span>YOUR NEXT FAVOURITE</span><h2>Discover the collection</h2><a href="#catalogue">Browse products ↗</a></div><%}%><%if(role==='admin'){%><a class="hero-edit" href="/admin/homepage">Edit hero ↗</a><%}%></div><script src="/javascripts/hero-carousel.js" defer></script>