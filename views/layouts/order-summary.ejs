<article class="purchase-card">
  <div class="purchase-heading"><div><span class="eyebrow">ORDER <%=order._id.toString().slice(-8).toUpperCase()%></span><p><%=new Date(order.orderDate).toLocaleString('en-SG',{timeZone:'Asia/Singapore',dateStyle:'medium',timeStyle:'short'})%> SGT</p></div><span class="purchase-status"><%=order.payment?.status==='succeeded'?'Paid · simulation':'Legacy demo order'%></span></div>
  <% order.products.forEach(item=>{ %><div class="purchase-item"><%if(item.productData.image && item.productData.image[0]){const image=item.productData.image[0];%><img src="data:<%=image.contentType%>;base64,<%=image.data%>" alt="<%=item.productData.name%>"><%}%><div><strong><%=item.productData.name%></strong><p>Qty <%=item.quantity%> · <%-money(Number(item.productData.price))%> each</p></div><strong><%-money((Math.round(Number(item.productData.price)*100)*item.quantity/100))%></strong></div><% }) %>
  <% const calculatedSubtotal = order.products.reduce((sum,item)=>sum+Math.round(Number(item.productData.price)*100)*item.quantity,0)/100; %>
  <dl class="purchase-totals"><div><dt>Subtotal</dt><dd><%-money((order.subtotal == null ? calculatedSubtotal : order.subtotal))%></dd></div>
  <%if(order.shipping != null && order.tax != null){%><div><dt>Shipping</dt><dd><%-money(order.shipping)%></dd></div><div><dt>Tax</dt><dd><%-money(order.tax)%></dd></div><%}else{%><div><dt>Other charges (legacy order)</dt><dd><%-money((order.total-calculatedSubtotal))%></dd></div><%}%>
  <div class="purchase-total"><dt>Total</dt><dd><%-money(order.total)%></dd></div></dl>
  <%if(order.delivery && order.delivery.address){const d=order.delivery;const a=d.address;%><div class="checkout-delivery"><strong>Delivery details</strong><p><%=d.name%> · <%=d.phone%><br><%=a.line1%><%=a.line2?', '+a.line2:''%>, <%=a.city%>, <%=a.region || ''%> <%=a.postalCode%>, <%=a.country%></p></div><%}%>
  <%if(order.payment?.reference){%><div class="payment-receipt"><strong>Simulated payment successful</strong><p><%=order.payment.method.replace('test-','Test ')%> · <%=order.payment.reference%></p><p>No funds were transferred. Order saved successfully.</p></div><%}%>
  <p class="field-hint">Recorded total: RM <%=Number(order.total).toFixed(2)%>. Other currencies use current reference rates, not historical rates.<br>Demo checkout · No payment collected. This is not a shipping confirmation.</p>
</article>
