<section class="admin-editor"><a class="text-link" href="/">← Back to store</a><div class="section-heading"><div><span class="eyebrow">CATALOGUE MANAGEMENT</span><h1><%=editing ? 'Edit product' : 'Add a new product'%></h1><p>Give customers the details they need to find their next upgrade.</p></div></div><form action="<%=(editing ? '/editProduct' : '/addProduct')+'?_csrf='+encodeURIComponent(csrfToken)%>" method="POST" enctype="multipart/form-data" data-product-editor><input type="hidden" name="_csrf" value="<%=csrfToken%>"><% if(editing){ %><input type="hidden" name="pId" value="<%=pId%>"><% } %><% if(error){ %><p class="error" role="alert"><%=error%></p><% } %><div class="admin-fields"><div><label for="product-name">Product name</label><input id="product-name" name="product_name" value="<%=product.name || ''%>" minlength="5" maxlength="50" required></div><div><label for="product-category">Category</label><select id="product-category" name="product_catagory" required><option value="">Choose a category</option><% [['computer','Computers'],['phone','Phones'],['headphone','Headphones'],['camera','Cameras'],['gaming','Gaming'],['wearable','Wearables']].forEach(([value,label])=>{ %><option value="<%=value%>" <%=product.catagory===value ? 'selected' : ''%>><%=label%></option><% }) %></select></div><div><label for="product-brand">Brand</label><input id="product-brand" name="product_brand" value="<%=product.brand || ''%>" maxlength="50" required></div><div><label for="product-price">Price (RM)</label><input id="product-price" name="product_price" type="number" min="1" max="20000" step="0.01" value="<%=product.price || ''%>" required></div></div><label for="product-tags">Collections (optional)</label><p class="field-hint" id="tags-hint">Add custom tags separated by commas, such as Work essentials, Travel, Gifts. Matching tags automatically group products into collections. Up to 8 tags, 32 characters each. Category describes the product type; collections describe a theme.</p><input id="product-tags" name="product_tags" maxlength="270" aria-describedby="tags-hint" placeholder="Work essentials, Travel, Gifts" value="<%=(product.tags || []).join(', ')%>"><div id="collection-tag-preview" class="collection-tag-preview" aria-live="polite"></div><label for="product-description">Description</label><p class="field-hint">What makes this product special? Use 20–2,000 characters.</p><textarea id="product-description" name="product_description" minlength="20" maxlength="2000" required><%=product.description || ''%></textarea><label for="product-specs">Specifications</label><p class="field-hint">Include the key technical details. Use 20–2,000 characters.</p><textarea id="product-specs" name="product_specs" minlength="20" maxlength="2000" required><%=product.specs || ''%></textarea><section class="image-manager"><label for="gallery-upload">Product gallery</label><p class="field-hint">Add up to 6 JPG or PNG images, 2 MB each. The first image is the cover. Changes are saved only when you save the product.</p><input id="gallery-upload" type="file" name="product_images" accept="image/jpeg,image/png" multiple><p id="gallery-feedback" role="status" aria-live="polite"></p><div id="gallery-editor"><% (product.image || []).forEach((image,index)=>{ %><article class="gallery-tile" data-existing="<%=index%>"><img src="data:<%=image.contentType%>;base64,<%=image.data%>" alt="<%=image.name || 'Product image'%>"><span><%=index===0?'Cover image':'Image '+(index+1)%></span></article><% }) %></div><input type="hidden" name="image_order" id="image-order"><button type="button" id="preview-gallery" class="gallery-preview-button">Preview gallery ↗</button><dialog id="gallery-dialog"><div class="preview-heading"><h2>Product gallery preview</h2><button type="button" id="close-gallery" aria-label="Close gallery preview">×</button></div><div class="preview-stage"><img id="gallery-preview-main" alt="Selected product image"></div><div id="gallery-preview-thumbs"></div><p class="field-hint">Preview only. Save your changes to update the storefront.</p></dialog></section><p id="product-save-error" class="error" role="alert"></p><div class="admin-form-actions"><a href="/">Cancel</a><button class="primary-link" type="submit"><%=editing ? 'Save changes' : 'Add product'%> ↗</button></div></form></section><script src="/javascripts/product-gallery.js" defer></script>