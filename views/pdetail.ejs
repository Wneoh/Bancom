<%- include('layouts/header'); -%>
<section class="product-page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Shop</a><span>/</span><a href="/?catagory=<%=product.catagory%>#catalogue"><%=product.catagory%></a><span>/</span><span><%=product.name%></span></nav><div class="product-overview"><div class="product-gallery"><div class="product-stage"><% if(product.image && product.image.length){ %><img id="product-main-image" src="data:<%=product.image[0].contentType%>;base64,<%=product.image[0].data%>" alt="<%=product.name%>"><% }else{ %><span>Image coming soon</span><% } %></div><% if(product.image.length>1){ %><div class="product-thumbnails" aria-label="Product images"><%product.image.forEach((img,i)=>{ %><button type="button" class="thumbnail <%=i===0?'selected':''%>" aria-label="View image <%=i+1%>" aria-pressed="<%=i===0%>"><img src="data:<%=img.contentType%>;base64,<%=img.data%>" alt="<%=product.name%>, view <%=i+1%>"></button><% }) %></div><% } %></div><div class="product-info"><span class="eyebrow"><%=product.brand%> / <%=product.catagory%></span><h1><%=product.name%></h1><p class="product-lead"><%=product.description.replace(/<[^>]*>/g,'').split(String.fromCharCode(10))[0]%></p><p class="detail-price"><%-money(product.price)%></p><%if(product.tags && product.tags.length){%><div class="product-collections" aria-label="Product collections"><%product.tags.forEach(tag=>{%><a href="/?collection=<%=encodeURIComponent(tag)%>#catalogue"><%=tag%></a><%})%></div><%}%><p class="price-note">Shipping and charges shown in your bag.</p><%- include('layouts/bag-button', {item:product,detail:true}); -%><% if(product.isDemo){ %><p class="detail-demo">Demo product · Fictional specifications and pricing. No payment is collected.</p><% } %><% if(role==='admin'){ %><a class="text-link" href="/editProduct?pid=<%=product._id%>">Edit this product ↗</a><% } %><div class="product-info-panels"><details open><summary>About this product</summary><p><%=product.description.replace(/<[^>]*>/g,'')%></p></details><details open><summary>Specifications</summary><p><%=product.specs.replace(/<[^>]*>/g,'')%></p></details></div></div></div><a class="text-link" href="/#catalogue">← Explore more products</a></section>
<%- include('layouts/footer'); -%>