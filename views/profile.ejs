<%-include('layouts/header')%><section class="profile-page"><a class="text-link" href="/">← Continue shopping</a><div class="profile-heading"><span class="eyebrow">YOUR BANCOM ACCOUNT</span><h1><%=welcome?'Welcome to Bancom':'Your profile'%></h1><p><%=required?'Add your contact and delivery details to continue checkout.':welcome?'Let’s get your profile ready for your first order.':'A few details for a smoother checkout.'%></p></div><%if(error){%><p class="profile-alert" role="alert"><%=error%></p><%}%><%if(saved){%><p class="profile-success" role="status">Your profile has been updated.</p><%}%>
<form class="profile-form" method="POST" action="/profile?_csrf=<%=encodeURIComponent(csrfToken)%>" enctype="multipart/form-data"><div class="profile-photo"><div class="profile-avatar" id="profile-avatar"><%if(profile.avatar && profile.avatar.data){%><img src="data:<%=profile.avatar.contentType%>;base64,<%=profile.avatar.data%>" alt="Your profile photo"><%}else{%><span><%=profile.name.slice(0,1).toUpperCase()%></span><%}%></div><div><label for="avatar">Profile photo <span>(optional)</span></label><p class="field-hint">JPG or PNG, up to 2 MB.</p><input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png"><%if(profile.avatar && profile.avatar.data){%><label class="remove-avatar"><input type="checkbox" name="removeAvatar"> Remove current photo</label><%}%><p id="photo-feedback" role="status"></p></div></div>
<div class="profile-order-link"><a class="text-link" href="/order">View my orders and purchased items ↗</a></div><h2>Contact details</h2><p class="field-hint">Required fields are marked *. We use these details for your orders.</p><div class="profile-fields"><div><label for="profile-name">Full name *</label><input id="profile-name" name="name" autocomplete="name" maxlength="80" required value="<%=profile.name%>"></div><div><label for="profile-phone">Phone number *</label><input id="profile-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" required placeholder="e.g. +60 12 345 6789" value="<%=profile.phone || ''%>"></div><div class="profile-wide"><label for="profile-email">Account email</label><input id="profile-email" type="email" value="<%=profile.email%>" readonly><p class="field-hint">Your sign-in email.</p></div></div>
<h2>Delivery address</h2><div class="profile-fields"><%const address=profile.address || {};for(const [key,label,autocomplete,requiredField,max] of [['line1','Street address','address-line1',true,150],['line2','Apartment, suite, etc.','address-line2',false,150],['city','City','address-level2',true,80],['region','State / province','address-level1',false,80],['postalCode','Postal code','postal-code',true,20],['country','Country','country-name',true,80]]){%><div class="<%=key.startsWith('line')?'profile-wide':''%>"><label for="profile-<%=key%>"><%=label%><%=requiredField?' *':' (optional)'%></label><input id="profile-<%=key%>" name="<%=key%>" autocomplete="<%=autocomplete%>" maxlength="<%=max%>" <%=requiredField?'required':''%> value="<%=address[key] || ''%>"></div><%}%></div><div class="profile-actions"><a href="/">Keep browsing</a><button class="primary-link" type="submit"><%=required?'Save and continue checkout':'Save profile'%> ↗</button></div></form></section><script src="/javascripts/profile.js" defer></script><%-include('layouts/footer')%>