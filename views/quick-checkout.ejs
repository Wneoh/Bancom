<%-include('layouts/header')%>
<%if(paymentError){%><p class="payment-error" role="alert"><%=paymentError%></p><%}%><section class="cart-shell quick-checkout"><a class="cart-back" href="/pDetail?pid=<%=product.id%>">← Back to product</a><header class="cart-heading"><div><span class="eyebrow">ONE GOOD CHOICE</span><h1>Quick checkout</h1></div><p>Review your item, then place your order. Your bag stays unchanged.</p></header>
<div class="cart-columns"><div class="cart-list"><div class="cart-list-heading">YOUR ITEM</div><article class="cart-row"><div class="cart-product-image"><%if(product.image && product.image[0]){%><img src="data:<%=product.image[0].contentType%>;base64,<%=product.image[0].data%>" alt="<%=product.name%>"><%}%></div><div class="cart-product-details"><span class="eyebrow"><%=product.brand%></span><h2><%=product.name%></h2><p><%-money(product.price)%> each</p><p>Quantity: <strong><%=draft.quantity%></strong></p><a href="/pDetail?pid=<%=product.id%>">Change quantity</a></div><strong><%-money(subtotal)%></strong></article></div>
<aside class="cart-checkout"><span class="eyebrow">THE DETAILS</span><h2>Order summary</h2><%if(currentProfile && profileComplete){const a=currentProfile.address;%><div class="checkout-delivery"><strong>Deliver to <%=currentProfile.name%></strong><p><%=a.line1%><%=a.line2?', '+a.line2:''%>, <%=a.city%>, <%=a.region || ''%> <%=a.postalCode%>, <%=a.country%><br><%=currentProfile.phone%></p><a href="/profile">Edit details</a></div><%}else{%><p class="checkout-delivery">Contact and delivery details are required. <a href="/profile">Complete profile ↗</a></p><%}%><dl><div><dt>Subtotal</dt><dd><%-money(subtotal)%></dd></div><div><dt>Shipping</dt><dd><%-money(6)%></dd></div><div><dt>Tax</dt><dd><%-money(5)%></dd></div><div class="cart-total"><dt>Total <small data-currency-code>MYR</small></dt><dd><%-money((Math.round(subtotal*100)+1100)/100)%></dd></div></dl><form action="/checkout" method="POST"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="checkoutKey" value="<%=draft.key%>"><%-include('layouts/payment-options')%><button class="primary-link" type="submit">Pay & place order ↗</button></form><p class="cart-checkout-note">Simulated payment only — no money is charged.<br>Orders are recorded in MYR. Converted totals are estimates.</p></aside></div></section><script src="/javascripts/payment.js" defer></script><%-include('layouts/footer')%>
