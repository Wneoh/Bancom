<%-include('layouts/header')%><section class="report-page"><div class="section-heading"><div><span class="eyebrow">ADMIN · STORE PERFORMANCE</span><h1>Sales reports</h1><p>Understand what sells and how your store is performing.</p></div><a class="text-link" href="/admin/orders">Customer orders ↗</a></div><form class="report-filters" method="GET"><div><label for="report-range">Period · Singapore time</label><select id="report-range" name="range"><%for(const [value,label] of [['7','Last 7 days'],['30','Last 30 days'],['90','Last 90 days'],['all','All time'],['custom','Custom dates']]){%><option value="<%=value%>" <%=range===value?'selected':''%>><%=label%></option><%}%></select></div><div class="report-date-field"><label for="report-from">Start date</label><input type="date" id="report-from" name="from" min="1900-01-01" max="2100-12-31" value="<%=from%>"></div><div class="report-date-field"><label for="report-to">End date (inclusive)</label><input type="date" id="report-to" name="to" min="1900-01-01" max="2100-12-31" value="<%=to%>"></div><div><label for="report-scope">Order dataset</label><select id="report-scope" name="scope"><option value="paid" <%=scope==='paid'?'selected':''%>>Successful simulated payments</option><option value="legacy" <%=scope==='legacy'?'selected':''%>>Legacy demo orders</option></select></div><button class="primary-link">Apply filters</button></form><%if(filterError){%><p class="payment-error" role="alert"><%=filterError%></p><%}%><p class="report-notice"><%if(range==='custom' && !filterError){%><strong><%=from%> to <%=to%> (inclusive).</strong> <%}%><%=scope==='paid'?'Successful simulated payments only. No real revenue or funds collected.':'Older demo orders without payment confirmation. These are not paid sales.'%> All amounts are recorded MYR. Dates use Singapore time.</p><div class="report-metrics"><%for(const [label,value] of [['Order value','RM '+report.gross.toFixed(2)],['Orders',report.orders],['Units sold',report.units],['Average order','RM '+report.average.toFixed(2)],['Unique customers',report.customers],['Product revenue','RM '+report.merchandise.toFixed(2)]]){%><article><span><%=label%></span><strong><%=value%></strong></article><%}%></div><%if(!report.orders){%><div class="catalogue-empty"><h2><%=filterError?'Choose a valid date range':'No matching orders yet'%></h2><p>Complete a simulated payment to populate this report, or select Legacy demo orders to inspect previous orders.</p><a href="/" class="primary-link">Browse products ↗</a></div><%}else{%><%-include('layouts/report-charts')%><div class="report-grid"><section class="report-panel"><h2>Best-selling products</h2><p>Ranked by units, then product revenue.</p><div class="report-table-wrap"><table><thead><tr><th>Product</th><th>Units</th><th>Orders</th><th>Revenue (MYR)</th></tr></thead><tbody><%report.products.forEach((p,i)=>{%><tr><td><span class="report-rank"><%=i+1%></span> <%=p.name%><small><%=p.category%></small></td><td><%=p.units%></td><td><%=p.orders%></td><td><%=(p.revenue/100).toFixed(2)%></td></tr><%})%></tbody></table></div></section><section class="report-panel"><h2>Category performance</h2><%report.categories.forEach(c=>{%><div class="report-category"><div><strong><%=c.name%></strong><span><%=c.units%> units · RM <%=(c.revenue/100).toFixed(2)%></span></div><meter min="0" max="<%=Math.max(1,report.merchandise*100)%>" value="<%=c.revenue%>" aria-label="<%=c.name%> revenue share"></meter></div><%})%><h2>Order value breakdown</h2><dl class="report-breakdown"><div><dt>Products</dt><dd>RM <%=report.merchandise.toFixed(2)%></dd></div><div><dt>Shipping</dt><dd>RM <%=report.shipping.toFixed(2)%></dd></div><div><dt>Tax</dt><dd>RM <%=report.tax.toFixed(2)%></dd></div></dl><p>Legacy orders may not have separate shipping and tax values. Revenue is not profit; product costs and refunds are not tracked.</p></section></div><section class="report-panel"><h2>Daily order trend</h2><p>Days with orders · Order value includes shipping and tax.</p><div class="report-table-wrap"><table><thead><tr><th>Date (SGT)</th><th>Orders</th><th>Order value (MYR)</th><th>Relative value</th></tr></thead><tbody><%const peak=Math.max(1,...report.days.map(d=>d.total));report.days.forEach(d=>{%><tr><td><%=d.date%></td><td><%=d.orders%></td><td><%=(d.total/100).toFixed(2)%></td><td><meter min="0" max="<%=peak%>" value="<%=d.total%>" aria-label="Order value on <%=d.date%>"></meter></td></tr><%})%></tbody></table></div></section><%}%><p class="field-hint">Checkout failures create no orders and are excluded. Conversion rates, profit and abandoned carts require additional tracking.</p></section><script src="/vendor/chartjs/chart.umd.min.js" defer></script><script src="/javascripts/report-charts.js" defer></script><%-include('layouts/footer')%>